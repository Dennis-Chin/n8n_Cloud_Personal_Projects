    {
      "parameters": {
        "jsCode": "// 1. Access n8n's persistent static workflow memory\nconst staticData = $getWorkflowStaticData('global');\nstaticData.seenIds = staticData.seenIds || [];\n\n// 2. Extract IDs from the incoming HTTP node\nconst allItems = $input.all();\nlet ids = [];\n\nif (allItems.length > 1) {\n  ids = allItems.map(item => item.json);\n} else if (allItems.length === 1) {\n  const val = allItems[0].json;\n  ids = Array.isArray(val) ? val : Object.values(val);\n}\n\n// 3. Flatten and filter to valid IDs\nconst flatIds = ids.flat().filter(id => typeof id === 'number' || typeof id === 'string');\n\n// 4. Grab the top 10 most recent posts, then filter out already seen IDs\nconst recentIds = flatIds.slice(0, 10);\nconst unseenIds = recentIds.filter(id => !staticData.seenIds.includes(id));\n\n// 5. Take up to 5 unseen items for processing\nconst targetIds = unseenIds.slice(0, 5);\n\n// 6. Record newly processed IDs in memory (keep last 200 to prevent unbounded growth)\nstaticData.seenIds = [...staticData.seenIds, ...targetIds].slice(-200);\n\n// 7. Output distinct rows for the next HTTP Request node\nreturn targetIds.map(id => ({\n  json: { story_id: id }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "49e016a1-13ae-4a48-bcaa-42f68f741e02",
